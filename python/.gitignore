# --- Python Basics ---
__pycache__/
*.py[cod]
*$py.class
*.code-workspace

# --- Virtual Environments ---
# It's common to name envs 'venv', 'env', or '.venv'
venv/
env/
.venv/
.env

# --- ROS2 / Colcon Build Artifacts (CRITICAL) ---
# You never want to push these. They are generated by 'colcon build'
build/
install/
log/

# --- IDE Settings ---
# Keep your personal editor settings out of shared code
.vscode/
.idea/

# --- OS Junk ---
.DS_Store
Thumbs.db

# --- Python Distribution ---
*.egg-info/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/

# --- Byte-compiled / Optimized / DLLs ---
__pycache__/
*.so