# -------------------------------------------------------------------
# --- General / OS / Editor ---
# -------------------------------------------------------------------
# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
.Trash-*
.nfs*
*.code-workspace

# Editor directories and files
.idea/

# Temporary and backup files
*~
*.swp
*.swo

# -------------------------------------------------------------------
# --- ROS 2 (Colcon Workspace) ---
# -------------------------------------------------------------------
# These directories are generated by the `colcon build` command.
/build/
/install/
/log/

# -------------------------------------------------------------------
# --- C++ / CMake Build Artifacts ---
# -------------------------------------------------------------------
# CMake generated files
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json

# C++ object files and intermediates
*.o
*.obj
*.slo
*.lo
*.d

# Precompiled headers
*.gch
*.pch

# Compiled libraries
*.so
*.dylib
*.dll
*.a
*.lib

# Executables
*.exe
*.out
*.app

# -------------------------------------------------------------------
# --- Docker Compose ---
# -------------------------------------------------------------------
# Environment files (often contain secrets)
.env
*.env

# Data volumes
# If you use docker-compose to mount local directories for persistent data
# (e.g., databases, logs), list those directories here.
# Example:
# /data/
# /db_data/

# Log files
*.log

.vscode/*
.vscode/settings.json
